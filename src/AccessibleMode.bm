Function IsAccessibleMode% Static

    IsAccessibleMode% = 0

    For argIndex% = 1 To _CommandCount
        argument$ = Command$(argIndex%)
        argument$ = LCase$(_Trim$(argument$))

        If argument$ = "--accessible" Or argument$ = "-a" Or argument$ = "/accessible" Then
            IsAccessibleMode% = 1
            Exit Function
        End If
    Next argIndex%

End Function


Function AccessibleReadCommand$ (promptText$) Static

    Print promptText$;
    Line Input commandValue$
    AccessibleReadCommand$ = LCase$(_Trim$(commandValue$))

End Function


Sub AccessibleMainMenu ()

    Print "Courtside College Basketball, version "; GAME_VERSION$
    Print "Accessible command-line mode."
    Print "All choices can be entered as a number or a word."
    Print

    exitRequested% = 0

    Do
        Print "Main menu"
        Print "1. Play a single game."
        Print "2. Accessibility help."
        Print "3. Exit."

        commandValue$ = AccessibleReadCommand$("Enter choice: ")
        Print

        Select Case commandValue$
            Case "1", "play", "game", "single"
                Call AccessibleSingleGameSetup

            Case "2", "help", "h", "?"
                Call AccessibleShowHelp

            Case "3", "exit", "quit", "q"
                Print "Exiting Courtside College Basketball."
                exitRequested% = 1

            Case Else
                Print "Choice not recognized. Enter 1 for play, 2 for help, or 3 to exit."
        End Select

        If exitRequested% = 0 Then Print
    Loop Until exitRequested% = 1

End Sub


Sub AccessibleSingleGameSetup ()

    yearNumber$ = ""
    visitorIdx = 0
    homeIdx = 0
    visitorName$ = ""
    homeName$ = ""

    Print "Single-game setup"
    Print "Enter back at any prompt to return to the main menu."

    Do
        If AccessibleChooseTeam%("visiting", yearNumber$, visitorIdx, visitorName$) = 0 Then Exit Sub
        If AccessibleChooseTeam%("home", yearNumber$, homeIdx, homeName$) = 0 Then Exit Sub

        Print
        Print "Matchup"
        Print "Visitor: "; AccessibleTeamDisplay$(visitorName$); " ("; yearNumber$; ")"
        Print "Home: "; AccessibleTeamDisplay$(homeName$); " ("; yearNumber$; ")"
        Print "1. Confirm matchup."
        Print "2. Change visiting team."
        Print "3. Change home team."
        Print "4. Cancel."

        commandValue$ = AccessibleReadCommand$("Enter choice: ")

        Select Case commandValue$
            Case "1", "confirm", "yes", "y"
                Print
                Print "Matchup confirmed: "; AccessibleTeamDisplay$(visitorName$); " at "; AccessibleTeamDisplay$(homeName$); "."
                If AccessibleConfigureGame% = 1 Then
                    If AccessiblePrepareMatchup%(yearNumber$, visitorIdx, homeIdx) = 1 Then
                        If AccessibleChooseStartingLineups% = 1 Then
                            Print
                            Print "Ready for tipoff."
                            Print "The next development phase will connect coaching commands and possession-by-possession play."
                        End If
                    End If
                Else
                    Print "Game configuration canceled."
                End If
                Exit Sub
            Case "2", "visitor", "visiting"
                visitorIdx = 0
            Case "3", "home"
                homeIdx = 0
            Case "4", "cancel", "back", "exit"
                Print "Single-game setup canceled."
                Exit Sub
            Case Else
                Print "Choice not recognized. Enter 1, 2, 3, or 4."
        End Select
    Loop

End Sub


Function AccessibleConfigureGame% Static

    AccessibleConfigureGame% = 0

    Print
    Print "Game control"
    Print "1. Human controls both teams."
    Print "2. Human controls home; computer controls visitor."
    Print "3. Human controls visitor; computer controls home."
    Print "4. Computer controls both teams."

    Do
        commandValue$ = AccessibleReadCommand$("Enter control mode, or back: ")
        If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Function
        accessiblePlayerOpt = Val(commandValue$) - 1
        If accessiblePlayerOpt >= 0 And accessiblePlayerOpt <= 3 And LTrim$(Str$(accessiblePlayerOpt + 1)) = commandValue$ Then Exit Do
        Print "Enter a number from 1 through 4."
    Loop

    Print
    Print "Game location"
    Print "1. Home-court advantage."
    Print "2. Neutral site."
    Do
        commandValue$ = AccessibleReadCommand$("Enter location, or back: ")
        If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Function
        accessibleGameLoc = Val(commandValue$)
        If accessibleGameLoc >= 1 And accessibleGameLoc <= 2 And LTrim$(Str$(accessibleGameLoc)) = commandValue$ Then Exit Do
        Print "Enter 1 for home court or 2 for neutral site."
    Loop

    Print
    Print "Rule settings"
    Print "1. Modern college rules: 30-second shot clock, three-point shot, five fouls to disqualify."
    Print "2. Custom rules."
    Do
        commandValue$ = AccessibleReadCommand$("Enter rule set, or back: ")
        If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Function
        If commandValue$ = "1" Or commandValue$ = "modern" Then
            accessibleShotClock = 30
            accessibleThreePoint = 1
            accessibleFoulsToDQ = 5
            Exit Do
        ElseIf commandValue$ = "2" Or commandValue$ = "custom" Then
            Do
                shotValue$ = AccessibleReadCommand$("Shot clock in seconds: 0, 30, 35, or 45: ")
                accessibleShotClock = Val(shotValue$)
                If shotValue$ = "0" Or shotValue$ = "30" Or shotValue$ = "35" Or shotValue$ = "45" Then Exit Do
                Print "Enter 0, 30, 35, or 45."
            Loop
            Do
                threeValue$ = AccessibleReadCommand$("Use the three-point shot? yes or no: ")
                If threeValue$ = "yes" Or threeValue$ = "y" Then
                    accessibleThreePoint = 1
                    Exit Do
                ElseIf threeValue$ = "no" Or threeValue$ = "n" Then
                    accessibleThreePoint = 0
                    Exit Do
                End If
                Print "Enter yes or no."
            Loop
            Do
                foulValue$ = AccessibleReadCommand$("Fouls to disqualify: 5 or 6: ")
                accessibleFoulsToDQ = Val(foulValue$)
                If foulValue$ = "5" Or foulValue$ = "6" Then Exit Do
                Print "Enter 5 or 6."
            Loop
            Exit Do
        Else
            Print "Enter 1 for modern rules or 2 for custom rules."
        End If
    Loop

    Print
    Print "Game configuration summary"
    Select Case accessiblePlayerOpt
        Case 0: Print "Control: human controls both teams."
        Case 1: Print "Control: human controls home; computer controls visitor."
        Case 2: Print "Control: human controls visitor; computer controls home."
        Case 3: Print "Control: computer controls both teams."
    End Select
    If accessibleGameLoc = 1 Then Print "Location: home-court advantage." Else Print "Location: neutral site."
    If accessibleShotClock = 0 Then Print "Shot clock: none." Else Print "Shot clock: "; LTrim$(Str$(accessibleShotClock)); " seconds."
    If accessibleThreePoint = 1 Then Print "Three-point shot: yes." Else Print "Three-point shot: no."
    Print "Fouls to disqualify: "; LTrim$(Str$(accessibleFoulsToDQ)); "."

    commandValue$ = AccessibleReadCommand$("Enter confirm to load the teams, or back: ")
    If commandValue$ = "confirm" Or commandValue$ = "yes" Or commandValue$ = "y" Or commandValue$ = "1" Then AccessibleConfigureGame% = 1

End Function


Function AccessiblePrepareMatchup% (yearNumber$, visitorIdx, homeIdx) Static

    AccessiblePrepareMatchup% = 0
    Call InitVar

    For gameIdx = 0 To 1
        If gameIdx = 0 Then selectedIdx = visitorIdx Else selectedIdx = homeIdx

        diskIDs$(gameIdx) = yearNumber$
        teamGender$(gameIdx) = GetTeamGender$(yearNumber$)
        teamYears(gameIdx) = Val(yearNumber$)

        Call ReadGameTeam(yearNumber$, gameTeams$(gameIdx), selectedIdx, gameIdx)
        validData = 0
        Call ReadGameExtraData(yearNumber$, selectedIdx, gameIdx, validData)
        If validData = 0 Then
            Print "The data for "; AccessibleTeamDisplay$(gameTeams$(gameIdx)); " could not be loaded."
            Exit Function
        End If

        FY%(gameIdx) = 2 * teamRat_GAME(gameIdx, 3) - teamRat_GAME(gameIdx, 4)
        Call StartingLineup(gameIdx)
        Call TEAMSETUP(gameIdx)
    Next gameIdx

    Print
    Print "Teams loaded successfully."
    Call AccessibleShowLoadedTeam(0, "Visiting")
    Call AccessibleShowLoadedTeam(1, "Home")
    AccessiblePrepareMatchup% = 1

End Function


Sub AccessibleShowLoadedTeam (gameIdx, roleName$)

    Print
    Print roleName$; " team: "; AccessibleTeamDisplay$(gameTeams$(gameIdx))
    If gameCoaches$(gameIdx) <> "" Then Print "Coach: "; gameCoaches$(gameIdx)
    If gameArena$(gameIdx) <> "" Then Print "Arena: "; gameArena$(gameIdx)
    Print "Roster:"
    rosterNumber = 0
    For playerIdx = 0 To 13
        If players$(gameIdx, playerIdx) <> "" And UCase$(players$(gameIdx, playerIdx)) <> "XXX" Then
            rosterNumber = rosterNumber + 1
            Print LTrim$(Str$(rosterNumber)); ". "; players$(gameIdx, playerIdx); ", position "; RTrim$(positions_GAME$(gameIdx, playerIdx));
            If playerActive%(gameIdx, playerIdx) = 0 Then Print ", unavailable";
            Print "."
        End If
    Next playerIdx
    commandValue$ = AccessibleReadCommand$("Enter continue when you are ready for the next section: ")

End Sub


Function AccessibleChooseStartingLineups% Static

    AccessibleChooseStartingLineups% = 0

    For gameIdx = 0 To 1
        computerControlled = 0
        If accessiblePlayerOpt = 3 Then computerControlled = 1
        If accessiblePlayerOpt = 1 And gameIdx = 0 Then computerControlled = 1
        If accessiblePlayerOpt = 2 And gameIdx = 1 Then computerControlled = 1

        If gameIdx = 0 Then roleName$ = "Visiting" Else roleName$ = "Home"
        If AccessibleChooseLineup%(gameIdx, roleName$, computerControlled) = 0 Then Exit Function
    Next gameIdx

    Print
    Print "Confirmed starting lineups"
    Call AccessiblePrintLineup(0, "Visiting")
    Call AccessiblePrintLineup(1, "Home")
    AccessibleChooseStartingLineups% = 1

End Function


Function AccessibleChooseLineup% (gameIdx, roleName$, computerControlled) Static

    Dim eligibleIndices(13)

    AccessibleChooseLineup% = 0
    Print
    Print roleName$; " starting lineup for "; AccessibleTeamDisplay$(gameTeams$(gameIdx)); "."

    If computerControlled = 1 Then
        Call AccessibleAutoLineup(gameIdx)
        Print "The computer selected this lineup."
        Call AccessiblePrintLineup(gameIdx, roleName$)
        AccessibleChooseLineup% = 1
        Exit Function
    End If

    Print "You may enter auto for a recommended lineup, or select five different player numbers."
    eligibleCount = 0
    For playerIdx = 0 To 13
        If playerActive%(gameIdx, playerIdx) = 1 And players$(gameIdx, playerIdx) <> "" And UCase$(players$(gameIdx, playerIdx)) <> "XXX" Then
            eligibleCount = eligibleCount + 1
            eligibleIndices(eligibleCount) = playerIdx
            Print LTrim$(Str$(eligibleCount)); ". "; players$(gameIdx, playerIdx); ", position "; RTrim$(positions_GAME$(gameIdx, playerIdx)); "."
        End If
    Next playerIdx

    For slot = 0 To 4
        Do
            commandValue$ = AccessibleReadCommand$("Choose starter "+ LTrim$(Str$(slot + 1)) + " of 5, auto, repeat, or back: ")
            If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Function
            If commandValue$ = "auto" Then
                Call AccessibleAutoLineup(gameIdx)
                AccessibleChooseLineup% = 1
                Call AccessiblePrintLineup(gameIdx, roleName$)
                Exit Function
            ElseIf commandValue$ = "repeat" Or commandValue$ = "list" Then
                For repeatIdx = 1 To eligibleCount
                    Print LTrim$(Str$(repeatIdx)); ". "; players$(gameIdx, eligibleIndices(repeatIdx)); ", position "; RTrim$(positions_GAME$(gameIdx, eligibleIndices(repeatIdx))); "."
                Next repeatIdx
            Else
                selectedNumber = Val(commandValue$)
                If selectedNumber >= 1 And selectedNumber <= eligibleCount And LTrim$(Str$(selectedNumber)) = commandValue$ Then
                    selectedPlayer = eligibleIndices(selectedNumber)
                    duplicatePlayer = 0
                    For checkSlot = 0 To slot - 1
                        If lineupIdx(gameIdx, checkSlot) = selectedPlayer Then duplicatePlayer = 1
                    Next checkSlot
                    If duplicatePlayer = 0 Then
                        lineupIdx(gameIdx, slot) = selectedPlayer
                        Print "Selected "; players$(gameIdx, selectedPlayer); "."
                        Exit Do
                    Else
                        Print "That player is already in the lineup."
                    End If
                Else
                    Print "Enter a displayed player number, auto, repeat, or back."
                End If
            End If
        Loop
    Next slot

    Call AccessiblePrintLineup(gameIdx, roleName$)
    commandValue$ = AccessibleReadCommand$("Enter confirm to accept this lineup, or back: ")
    If commandValue$ = "confirm" Or commandValue$ = "yes" Or commandValue$ = "y" Or commandValue$ = "1" Then AccessibleChooseLineup% = 1

End Function


Sub AccessibleAutoLineup (gameIdx)

    For slot = 0 To 4
        bestPlayer = -1
        bestContribution! = -1
        For playerIdx = 0 To 13
            alreadyChosen = 0
            For checkSlot = 0 To slot - 1
                If lineupIdx(gameIdx, checkSlot) = playerIdx Then alreadyChosen = 1
            Next checkSlot
            If alreadyChosen = 0 And playerActive%(gameIdx, playerIdx) = 1 And players$(gameIdx, playerIdx) <> "" And UCase$(players$(gameIdx, playerIdx)) <> "XXX" Then
                If plyrOff_GAME!(gameIdx, playerIdx, 3) > bestContribution! Then
                    bestContribution! = plyrOff_GAME!(gameIdx, playerIdx, 3)
                    bestPlayer = playerIdx
                End If
            End If
        Next playerIdx
        lineupIdx(gameIdx, slot) = bestPlayer
    Next slot

End Sub


Sub AccessiblePrintLineup (gameIdx, roleName$)

    Print roleName$; " lineup:"
    For slot = 0 To 4
        playerIdx = lineupIdx(gameIdx, slot)
        If playerIdx >= 0 Then
            Print LTrim$(Str$(slot + 1)); ". "; players$(gameIdx, playerIdx); ", position "; RTrim$(positions_GAME$(gameIdx, playerIdx)); "."
        End If
    Next slot

End Sub


Function AccessibleChooseTeam% (roleName$, yearNumber$, chosenIdx, teamName$) Static

    Dim matchIndices(MAX_TEAMS)

    AccessibleChooseTeam% = 0

    Do
        If chosenIdx = 0 Then
            Print
            Print "Choose the "; roleName$; " team."

            If yearNumber$ = "" Then
                commandValue$ = AccessibleReadCommand$("Enter season ID, such as 2025, or back: ")
            Else
                Print "Current season ID: "; yearNumber$
                commandValue$ = AccessibleReadCommand$("Press Enter to use it, enter another season ID, or back: ")
                If commandValue$ = "" Then commandValue$ = yearNumber$
            End If

            If commandValue$ = "back" Or commandValue$ = "cancel" Or commandValue$ = "exit" Then Exit Function

            If AccessibleLoadTeams%(commandValue$) = 0 Then
                Print "No team data was found for season ID "; commandValue$; "."
                Print "Try a four-digit season from 1959 through 2025."
            Else
                yearNumber$ = commandValue$

                Do
                    searchValue$ = AccessibleReadCommand$("Enter part of a team name, list, or back: ")
                    If searchValue$ = "back" Or searchValue$ = "cancel" Then Exit Do

                    matchCount = 0
                    For teamIdx = 1 To teamIndex(0)
                        If searchValue$ = "list" Or searchValue$ = "" Or InStr(LCase$(teamNames$(teamIdx)), searchValue$) > 0 Then
                            matchCount = matchCount + 1
                            matchIndices(matchCount) = teamIdx
                        End If
                    Next teamIdx

                    If matchCount = 0 Then
                        Print "No teams matched. Try another search."
                    Else
                        displayCount = matchCount
                        If displayCount > 25 Then displayCount = 25
                        Print LTrim$(Str$(matchCount)); " team(s) matched."
                        For matchIdx = 1 To displayCount
                            Print LTrim$(Str$(matchIdx)); ". "; AccessibleTeamDisplay$(teamNames$(matchIndices(matchIdx)))
                        Next matchIdx
                        If matchCount > displayCount Then Print "Only the first 25 matches are shown. Narrow the search to see fewer results."

                        selectionValue$ = AccessibleReadCommand$("Enter a displayed team number, search, or back: ")
                        If selectionValue$ = "back" Or selectionValue$ = "cancel" Then Exit Do
                        If selectionValue$ <> "search" Then
                            selectedNumber = Val(selectionValue$)
                            If selectedNumber >= 1 And selectedNumber <= displayCount And LTrim$(Str$(selectedNumber)) = selectionValue$ Then
                                chosenIdx = teamIndex(matchIndices(selectedNumber))
                                teamName$ = teamNames$(matchIndices(selectedNumber))
                                Print "Selected "; AccessibleTeamDisplay$(teamName$); " as the "; roleName$; " team."
                                AccessibleChooseTeam% = 1
                                Exit Function
                            Else
                                Print "That is not a displayed team number."
                            End If
                        End If
                    End If
                Loop
            End If
        Else
            AccessibleChooseTeam% = 1
            Exit Function
        End If
    Loop

End Function


Function AccessibleTeamDisplay$ (teamName$) Static

    displayName$ = RTrim$(teamName$)
    If Len(displayName$) >= 4 Then
        If Mid$(displayName$, 3, 1) = " " And Val(Left$(displayName$, 2)) > 0 Then displayName$ = Mid$(displayName$, 4)
    End If
    AccessibleTeamDisplay$ = displayName$

End Function


Function AccessibleLoadTeams% (yearNumber$) Static

    AccessibleLoadTeams% = 0
    teamFile$ = diskPaths$(0) + TEAM_FILE_NAME$ + "." + yearNumber$
    dataFile$ = diskPaths$(0) + DATA_FILE_NAME$ + "." + yearNumber$

    If Not _FileExists(teamFile$) Or Not _FileExists(dataFile$) Then Exit Function

    Open teamFile$ For Random As #1 Len = TEAM_SIZE_BYTES
    fileLength& = LOF(1)
    numberTeams = fileLength& / TEAM_SIZE_BYTES
    If numberTeams > MAX_TEAMS Then numberTeams = MAX_TEAMS
    Field #1, 15 As Q$(0)

    For teamIdx = 1 To numberTeams
        Get #1, teamIdx
        teamNames$(teamIdx) = Q$(0)
        teamIndex(teamIdx) = teamIdx
    Next teamIdx
    Close #1

    teamIndex(0) = numberTeams
    AccessibleLoadTeams% = numberTeams

End Function


Sub AccessibleShowHelp ()

    Print "Accessibility help"
    Print "This mode uses complete lines of text so screen readers can follow the game."
    Print "Enter a menu number or its command word, then press Enter."
    Print "No mouse, color, graphics, or cursor position is required."
    Print "At the main menu, enter play, help, or exit."

End Sub
