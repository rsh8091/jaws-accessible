Function AccessibleHtml$ (value$) Static

    htmlValue$ = String.Replace$(value$, "&", "&amp;")
    htmlValue$ = String.Replace$(htmlValue$, "<", "&lt;")
    htmlValue$ = String.Replace$(htmlValue$, ">", "&gt;")
    htmlValue$ = String.Replace$(htmlValue$, Chr$(34), "&quot;")
    AccessibleHtml$ = htmlValue$

End Function


Function AccessibleReadCommand$ (promptText$) Static

    Print promptText$;
    Line Input commandValue$
    AccessibleReadCommand$ = LCase$(_Trim$(commandValue$))

End Function


Sub AccessibleMainMenu ()

    accessiblePauseEvents = 1
    If IsAccessibleTestMode% = 1 Then accessiblePauseEvents = 0
    Print "Courtside College Basketball, version "; GAME_VERSION$
    Print "Accessible command-line mode."
    Print "All choices can be entered as a number or a word."
    Print

    If IsAccessibleBoxscoreTestMode% = 1 Then
        Print "Accessible box score test mode."
        Call AccessibleLoadBoxscoreFixture
        If IsAccessibleBoxscoreHtmlTestMode% = 1 Then
            htmlSeparator$ = "/"
            If InStr(_OS$, "[WINDOWS]") > 0 Then htmlSeparator$ = "\"
            htmlPath$ = _CWD$ + htmlSeparator$ + "accessible-boxscore.html"
            Call AccessibleWriteHtmlBoxscore(htmlPath$)
            Print "Accessible HTML box score created: "; htmlPath$
            Print "Exiting Courtside College Basketball."
            Exit Sub
        ElseIf IsAccessibleBoxscoreTransitionTestMode% = 1 Then
            Print "Automated accessible box score validation."
            Call AccessiblePrintGameSummary
            Call AccessiblePrintTeamTotals(0)
            Call AccessiblePrintPlayerList(0)
            Call AccessiblePrintPlayerStats(0, 4)
            Call AccessiblePrintPlayerStats(0, 5)
            Print "You have completed the visiting team player box score for "; AccessibleTeamDisplay$(gameTeams$(0)); "."
            Print "Moving to the home team player box score for "; AccessibleTeamDisplay$(gameTeams$(1)); "."
            Call AccessiblePrintTeamTotals(1)
            Call AccessiblePrintPlayerList(1)
            Call AccessiblePrintPlayerStats(1, 5)
            Print "You have completed the home team player box score for "; AccessibleTeamDisplay$(gameTeams$(1)); "."
            Print "Exiting Courtside College Basketball."
            Exit Sub
        Else
            Call AccessiblePrintRegulationSummary
            Call AccessiblePostgameMenu
            Print
            Print "Box score test complete. Returning to the accessible main menu."
            Print
        End If
    End If

    exitRequested% = 0

    Do
        Print "Main menu"
        Print "1. Play a single game."
        Print "2. Accessibility help."
        Print "3. Exit."

        commandValue$ = AccessibleReadCommand$("Enter choice: ")
        Print

        Select Case commandValue$
            Case "1", "play", "game", "single"
                Call AccessibleSingleGameSetup

            Case "2", "help", "h", "?"
                Call AccessibleShowHelp

            Case "3", "exit", "quit", "q"
                Print "Exiting Courtside College Basketball."
                exitRequested% = 1

            Case Else
                Print "Choice not recognized. Enter 1 for play, 2 for help, or 3 to exit."
        End Select

        If exitRequested% = 0 Then Print
    Loop Until exitRequested% = 1

End Sub


Sub AccessibleSingleGameSetup ()

    visitorYear$ = ""
    homeYear$ = ""
    visitorIdx = 0
    homeIdx = 0
    visitorName$ = ""
    homeName$ = ""

    Print "Single-game setup"
    Print "Enter back at any prompt to return to the main menu."

    Do
        If AccessibleChooseTeam%("visiting", visitorYear$, visitorIdx, visitorName$) = 0 Then Exit Sub
        If AccessibleChooseTeam%("home", homeYear$, homeIdx, homeName$) = 0 Then Exit Sub

        Print
        Print "Matchup"
        Print "Visitor: "; AccessibleTeamDisplay$(visitorName$); " ("; visitorYear$; ")"
        Print "Home: "; AccessibleTeamDisplay$(homeName$); " ("; homeYear$; ")"
        Print "1. Confirm matchup."
        Print "2. Change visiting team."
        Print "3. Change home team."
        Print "4. Cancel."

        commandValue$ = AccessibleReadCommand$("Enter choice: ")

        Select Case commandValue$
            Case "1", "confirm", "yes", "y"
                Print
                Print "Matchup confirmed: "; AccessibleTeamDisplay$(visitorName$); " at "; AccessibleTeamDisplay$(homeName$); "."
                If AccessibleConfigureGame% = 1 Then
                    If AccessiblePrepareMatchup%(visitorYear$, homeYear$, visitorIdx, homeIdx) = 1 Then
                        If AccessibleChooseStartingLineups% = 1 Then
                            Print
                            Print "Ready for tipoff."
                            Call AccessibleRunGame
                        End If
                    End If
                Else
                    Print "Game configuration canceled."
                End If
                Exit Sub
            Case "2", "visitor", "visiting"
                visitorIdx = 0
            Case "3", "home"
                homeIdx = 0
            Case "4", "cancel", "back", "exit"
                Print "Single-game setup canceled."
                Exit Sub
            Case Else
                Print "Choice not recognized. Enter 1, 2, 3, or 4."
        End Select
    Loop

End Sub


Sub AccessibleRunGame ()

    Print
    Print "Original simulator validation."
    If IsAccessibleHalftimeTestMode% = 1 Then
        Print "Automated halftime transition validation."
        accessibleEngineLimit = 0
        accessibleEngineStopClock = 0
    ElseIf accessiblePlayerOpt = 3 Then
        Print "The original game engine will coach both teams for six possessions."
        accessibleEngineLimit = 6
        accessibleEngineStopClock = 0
    Else
        If accessiblePauseEvents = 0 Then
            Print "The original game engine will play one possession for each team."
            accessibleEngineLimit = 2
            accessibleEngineStopClock = 0
        Else
            Print "The original game engine will play through the end of regulation."
            Print "Halftime includes an accessible review before the second half begins."
            accessibleEngineLimit = 0
            accessibleEngineStopClock = 0
        End If
        Print "Computer play runs continuously. Your team pauses when a decision is required."
    End If
    Print "Play-by-play is being presented through the accessible command-line adapter."

    accessiblePreparedGame = 1
    accessibleEngineMode = 1
    accessibleEnginePossessions = 0
    accessibleEngineLastTeam = -1
    accessibleEngineHumanPrompted = 0
    accessibleEngineStopRequested = 0
    accessibleLastPbp$ = ""
    accessiblePbpGroupCount = 0
    accessiblePbpGroupTeam = -1
    Erase accessiblePbpGroup$
    Call COLHOOP
    Call AccessibleFlushPbp

    accessibleEngineMode = 0
    accessiblePreparedGame = 0
    Print "Original simulator validation complete."

End Sub


Sub AccessiblePrintHalftimeSummary ()

    Print "Halftime."
    Print "Score: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(score(0, 0))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(score(1, 0))); "."
    Print "First-half team fouls: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(teamFouls(0))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(teamFouls(1))); "."
    Print "Timeouts remaining: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(timeouts(0))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(timeouts(1))); "."
    Print "Halftime rest applied. Temporary fatigue has been reset."

End Sub


Function AccessibleHalftimeMenu% Static

    Call AccessibleFlushPbp
    AccessibleHalftimeMenu% = 0
    Do
        Cls
        Call AccessiblePrintHalftimeSummary
        Print
        Print "Halftime options"
        Print "1. Start the second half."
        Print "2. Hear the visiting lineup."
        Print "3. Hear the home lineup."
        If accessiblePlayerOpt < 3 Then Print "4. Make a halftime substitution."
        Print "5. End the game segment at halftime."
        commandValue$ = AccessibleReadCommand$("Enter choice: ")

        Select Case commandValue$
            Case "1", "continue", "start", "second half"
                AccessibleHalftimeMenu% = 1
                Exit Do
            Case "2", "visitor", "visiting"
                Call AccessiblePrintLineupCondition(0)
                commandValue$ = AccessibleReadCommand$("Press Enter to return to halftime options: ")
            Case "3", "home"
                Call AccessiblePrintLineupCondition(1)
                commandValue$ = AccessibleReadCommand$("Press Enter to return to halftime options: ")
            Case "4", "sub", "substitute", "substitution"
                If accessiblePlayerOpt = 0 Then
                    Print "Choose the team to change."
                    Print "1. Visiting team."
                    Print "2. Home team."
                    teamChoice$ = AccessibleReadCommand$("Enter choice, or back: ")
                    If teamChoice$ = "1" Or teamChoice$ = "visitor" Or teamChoice$ = "visiting" Then Call AccessibleSubstitutionMenu(0)
                    If teamChoice$ = "2" Or teamChoice$ = "home" Then Call AccessibleSubstitutionMenu(1)
                ElseIf accessiblePlayerOpt = 1 Then
                    Call AccessibleSubstitutionMenu(1)
                ElseIf accessiblePlayerOpt = 2 Then
                    Call AccessibleSubstitutionMenu(0)
                Else
                    Print "Both teams are computer controlled."
                    commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
                End If
                Print "Halftime substitution review complete. Returning to halftime options."
                Print "Choose 1 when you are ready to start the second half."
                commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
            Case "5", "finish", "end", "quit", "exit"
                Exit Do
            Case Else
                Print "Enter a choice from 1 through 5."
                commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
        End Select
    Loop

End Function


Sub AccessiblePrintRegulationSummary ()

    Call AccessibleFlushPbp
    Cls
    If currHalf > 3 Then
        Print "End of overtime "; LTrim$(Str$(currHalf - 3)); "."
        Print "Final score: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(score(0, 0))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(score(1, 0))); "."
    Else
        Print "End of regulation."
        Print "Final regulation score: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(score(0, 0))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(score(1, 0))); "."
    End If
    Print "Timeouts remaining: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(timeouts(0))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(timeouts(1))); "."
    Print "The game is over."
    commandValue$ = AccessibleReadCommand$("Press Enter to continue to postgame options: ")

End Sub


Sub AccessiblePrintOvertimeTransition (overtimeNumber)

    Call AccessibleFlushPbp
    Cls
    If overtimeNumber = 1 Then
        Print "End of regulation."
        Print "The score is tied: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(score(0, 0))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(score(1, 0))); "."
    Else
        Print "End of overtime "; LTrim$(Str$(overtimeNumber - 1)); "."
        Print "The score remains tied: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(score(0, 0))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(score(1, 0))); "."
    End If
    Print "Overtime "; LTrim$(Str$(overtimeNumber)); " will be five minutes."
    Print "Each team receives one additional timeout."
    commandValue$ = AccessibleReadCommand$("Press Enter to begin overtime: ")

End Sub


Sub AccessiblePostgameMenu ()

    Do
        Cls
        Print "Postgame options."
        Print "1. Hear the game summary."
        Print "2. Hear the visiting team box score."
        Print "3. Hear the home team box score."
        Print "4. Create the HTML box score and open the folder containing it."
        Print "5. Return to the main menu."
        commandValue$ = AccessibleReadCommand$("Enter choice: ")
        Select Case commandValue$
            Case "1"
                Call AccessiblePrintGameSummary
                commandValue$ = AccessibleReadCommand$("Press Enter to return to postgame options: ")
            Case "2"
                Call AccessibleTeamBoxscoreMenu(0)
            Case "3"
                Call AccessibleTeamBoxscoreMenu(1)
            Case "4"
                Call AccessibleOpenHtmlBoxscore
            Case "5"
                Exit Do
            Case Else
                Print "Enter a choice from 1 through 5."
                commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
        End Select
    Loop

End Sub


Sub AccessibleOpenHtmlBoxscore ()

    htmlSeparator$ = "/"
    If InStr(_OS$, "[WINDOWS]") > 0 Then htmlSeparator$ = "\"
    htmlPath$ = _CWD$ + htmlSeparator$ + "accessible-boxscore.html"
    Call AccessibleWriteHtmlBoxscore(htmlPath$)
    Print "The accessible HTML box score has been created."
    Print "The folder containing the accessible box score is opening."
    Print "The file is named accessible-boxscore.html."
    Print "Locate that file and press Enter to open it in your preferred browser."
    localOsType$ = Left$(_OS$, InStr(2, _OS$, "[") - 1)
    Select Case localOsType$
        Case "[WINDOWS]"
            launchCommand$ = "explorer.exe " + Chr$(34) + _CWD$ + Chr$(34)
        Case "[MAC]", "[MACOSX]"
            launchCommand$ = "open " + Chr$(34) + _CWD$ + Chr$(34)
        Case Else
            launchCommand$ = "xdg-open " + Chr$(34) + _CWD$ + Chr$(34)
    End Select
    Shell _DontWait launchCommand$
    commandValue$ = AccessibleReadCommand$("After reviewing accessible-boxscore.html, return to the game and press Enter to continue: ")

End Sub


Sub AccessibleWriteHtmlBoxscore (htmlPath$)

    htmlFile = FreeFile
    Open htmlPath$ For Output As #htmlFile
    Print #htmlFile, "<!doctype html>"
    Print #htmlFile, "<html lang=" + Chr$(34) + "en" + Chr$(34) + "><head><meta charset=" + Chr$(34) + "utf-8" + Chr$(34) + ">"
    Print #htmlFile, "<meta name=" + Chr$(34) + "viewport" + Chr$(34) + " content=" + Chr$(34) + "width=device-width, initial-scale=1" + Chr$(34) + ">"
    Print #htmlFile, "<title>Box score: " + AccessibleHtml$(gameTeams$(0)) + " versus " + AccessibleHtml$(gameTeams$(1)) + "</title>"
    Print #htmlFile, "<style>body{font-family:Arial,sans-serif;line-height:1.5;max-width:90rem;margin:1rem auto;padding:0 1rem;color:#111;background:#fff}table{border-collapse:collapse;width:100%;margin:1rem 0 2rem}caption{font-size:1.35rem;font-weight:bold;text-align:left;padding:.5rem 0}th,td{border:1px solid #555;padding:.45rem;text-align:right}th[scope=row]{text-align:left}thead th{background:#eee}tfoot th,tfoot td{font-weight:bold;background:#f4f4f4}.table-wrap{overflow-x:auto}</style></head><body><main>"
    Print #htmlFile, "<h1>Courtside College Basketball box score</h1>"
    If score(0, 0) > score(1, 0) Then
        resultText$ = gameTeams$(0) + " defeated " + gameTeams$(1) + ", " + LTrim$(Str$(score(0, 0))) + " to " + LTrim$(Str$(score(1, 0))) + "."
    ElseIf score(1, 0) > score(0, 0) Then
        resultText$ = gameTeams$(1) + " defeated " + gameTeams$(0) + ", " + LTrim$(Str$(score(1, 0))) + " to " + LTrim$(Str$(score(0, 0))) + "."
    Else
        resultText$ = "The game ended tied at " + LTrim$(Str$(score(0, 0))) + "."
    End If
    Print #htmlFile, "<section aria-labelledby=" + Chr$(34) + "summary-heading" + Chr$(34) + "><h2 id=" + Chr$(34) + "summary-heading" + Chr$(34) + ">Game summary</h2>"
    Print #htmlFile, "<p><strong>" + AccessibleHtml$(resultText$) + "</strong></p>"
    Print #htmlFile, "<ul><li>First half: " + AccessibleHtml$(gameTeams$(0)) + " " + LTrim$(Str$(score(0, 1))) + ", " + AccessibleHtml$(gameTeams$(1)) + " " + LTrim$(Str$(score(1, 1))) + ".</li>"
    Print #htmlFile, "<li>Second half: " + AccessibleHtml$(gameTeams$(0)) + " " + LTrim$(Str$(score(0, 2))) + ", " + AccessibleHtml$(gameTeams$(1)) + " " + LTrim$(Str$(score(1, 2))) + ".</li>"
    If currHalf > 3 Then
        For overtimeIdx = 3 To currHalf - 1
            Print #htmlFile, "<li>Overtime " + LTrim$(Str$(overtimeIdx - 2)) + ": " + AccessibleHtml$(gameTeams$(0)) + " " + LTrim$(Str$(score(0, overtimeIdx))) + ", " + AccessibleHtml$(gameTeams$(1)) + " " + LTrim$(Str$(score(1, overtimeIdx))) + ".</li>"
        Next overtimeIdx
    End If
    Print #htmlFile, "</ul></section>"
    Print #htmlFile, "<p id=" + Chr$(34) + "table-help" + Chr$(34) + ">Each table uses player names as row headings and statistics as column headings. DNP means did not play.</p>"
    Call AccessibleWriteHtmlTeamTable(htmlFile, 0)
    Call AccessibleWriteHtmlTeamTable(htmlFile, 1)
    Print #htmlFile, "</main></body></html>"
    Close #htmlFile

End Sub


Sub AccessibleWriteHtmlTeamTable (htmlFile, teamIdx)

    Erase statTotals
    For playerIdx = 0 To 13
        If players$(teamIdx, playerIdx) <> "XXX" Then
            statTotals(0) = statTotals(0) + plyrOff_GAME!(teamIdx, playerIdx, 8)
            statTotals(1) = statTotals(1) + plyrOff_GAME!(teamIdx, playerIdx, 7)
            statTotals(2) = statTotals(2) + plyrOff_GAME!(teamIdx, playerIdx, 10)
            statTotals(3) = statTotals(3) + plyrOff_GAME!(teamIdx, playerIdx, 9)
            statTotals(5) = statTotals(5) + plyrOff_GAME!(teamIdx, playerIdx, 8) * 2 + plyrOff_GAME!(teamIdx, playerIdx, 10) + threeFG(teamIdx, playerIdx, 0)
            statTotals(6) = statTotals(6) + plyrOff_GAME!(teamIdx, playerIdx, 12)
            statTotals(7) = statTotals(7) + plyrOff_GAME!(teamIdx, playerIdx, 14)
            statTotals(8) = statTotals(8) + plyrOff_GAME!(teamIdx, playerIdx, 15)
            statTotals(9) = statTotals(9) + plyrOff_GAME!(teamIdx, playerIdx, 13)
            statTotals(10) = statTotals(10) + timePlayed(teamIdx, playerIdx)
            statTotals(11) = statTotals(11) + plyrOff_GAME!(teamIdx, playerIdx, 24)
            statTotals(13) = statTotals(13) + threeFG(teamIdx, playerIdx, 0)
            statTotals(14) = statTotals(14) + threeFG(teamIdx, playerIdx, 1)
        End If
    Next playerIdx

    teamId$ = "team-" + LTrim$(Str$(teamIdx))
    Print #htmlFile, "<section aria-labelledby=" + Chr$(34) + teamId$ + Chr$(34) + "><h2 id=" + Chr$(34) + teamId$ + Chr$(34) + ">" + AccessibleHtml$(gameTeams$(teamIdx)) + "</h2><div class=" + Chr$(34) + "table-wrap" + Chr$(34) + ">"
    Print #htmlFile, "<table aria-describedby=" + Chr$(34) + "table-help" + Chr$(34) + "><caption>" + AccessibleHtml$(gameTeams$(teamIdx)) + " player and team statistics</caption>"
    Print #htmlFile, "<thead><tr>"
    Print #htmlFile, "<th scope=" + Chr$(34) + "col" + Chr$(34) + ">Player</th><th scope=" + Chr$(34) + "col" + Chr$(34) + ">Minutes</th><th scope=" + Chr$(34) + "col" + Chr$(34) + ">Field goals</th><th scope=" + Chr$(34) + "col" + Chr$(34) + ">Three-pointers</th><th scope=" + Chr$(34) + "col" + Chr$(34) + ">Free throws</th>"
    Print #htmlFile, "<th scope=" + Chr$(34) + "col" + Chr$(34) + ">Offensive rebounds</th><th scope=" + Chr$(34) + "col" + Chr$(34) + ">Total rebounds</th><th scope=" + Chr$(34) + "col" + Chr$(34) + ">Points</th><th scope=" + Chr$(34) + "col" + Chr$(34) + ">Fouls</th><th scope=" + Chr$(34) + "col" + Chr$(34) + ">Assists</th><th scope=" + Chr$(34) + "col" + Chr$(34) + ">Blocks</th><th scope=" + Chr$(34) + "col" + Chr$(34) + ">Steals</th><th scope=" + Chr$(34) + "col" + Chr$(34) + ">Turnovers</th>"
    Print #htmlFile, "</tr></thead><tbody>"
    For playerIdx = 0 To 13
        If players$(teamIdx, playerIdx) <> "XXX" Then
            If timePlayed(teamIdx, playerIdx) = 0 Then
                minutesText$ = "DNP"
            Else
                playerMinutes = Int(timePlayed(teamIdx, playerIdx) / 60)
                playerSeconds = timePlayed(teamIdx, playerIdx) - playerMinutes * 60
                minutesText$ = LTrim$(Str$(playerMinutes)) + ":" + Right$("0" + LTrim$(Str$(playerSeconds)), 2)
            End If
            playerPoints = plyrOff_GAME!(teamIdx, playerIdx, 8) * 2 + plyrOff_GAME!(teamIdx, playerIdx, 10) + threeFG(teamIdx, playerIdx, 0)
            Print #htmlFile, "<tr><th scope=" + Chr$(34) + "row" + Chr$(34) + ">" + AccessibleHtml$(players$(teamIdx, playerIdx)) + "</th>"
            Print #htmlFile, "<td>" + minutesText$ + "</td><td>" + LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 8))) + " of " + LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 7))) + "</td><td>" + LTrim$(Str$(threeFG(teamIdx, playerIdx, 0))) + " of " + LTrim$(Str$(threeFG(teamIdx, playerIdx, 1))) + "</td><td>" + LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 10))) + " of " + LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 9))) + "</td>"
            Print #htmlFile, "<td>" + LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 24))) + "</td><td>" + LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 11))) + "</td><td>" + LTrim$(Str$(playerPoints)) + "</td><td>" + LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 12))) + "</td><td>" + LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 14))) + "</td><td>" + LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 15))) + "</td><td>" + LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 13))) + "</td><td>" + LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 23))) + "</td></tr>"
        End If
    Next playerIdx
    Print #htmlFile, "</tbody><tfoot><tr><th scope=" + Chr$(34) + "row" + Chr$(34) + ">Team totals</th>"
    Print #htmlFile, "<td>" + LTrim$(Str$(Int(statTotals(10) / 60))) + "</td><td>" + LTrim$(Str$(statTotals(0))) + " of " + LTrim$(Str$(statTotals(1))) + "</td><td>" + LTrim$(Str$(statTotals(13))) + " of " + LTrim$(Str$(statTotals(14))) + "</td><td>" + LTrim$(Str$(statTotals(2))) + " of " + LTrim$(Str$(statTotals(3))) + "</td>"
    Print #htmlFile, "<td>" + LTrim$(Str$(statTotals(11))) + "</td><td>" + LTrim$(Str$(teamRebounds(teamIdx))) + "</td><td>" + LTrim$(Str$(score(teamIdx, 0))) + "</td><td>" + LTrim$(Str$(statTotals(6))) + "</td><td>" + LTrim$(Str$(statTotals(7))) + "</td><td>" + LTrim$(Str$(statTotals(8))) + "</td><td>" + LTrim$(Str$(statTotals(9))) + "</td><td>" + LTrim$(Str$(turnovers(teamIdx))) + "</td></tr></tfoot></table></div></section>"

End Sub


Sub AccessiblePrintGameSummary ()

    Cls
    Print "Game summary."
    If score(0, 0) > score(1, 0) Then
        Print AccessibleTeamDisplay$(gameTeams$(0)); " defeated "; AccessibleTeamDisplay$(gameTeams$(1)); ", "; LTrim$(Str$(score(0, 0))); " to "; LTrim$(Str$(score(1, 0))); "."
    ElseIf score(1, 0) > score(0, 0) Then
        Print AccessibleTeamDisplay$(gameTeams$(1)); " defeated "; AccessibleTeamDisplay$(gameTeams$(0)); ", "; LTrim$(Str$(score(1, 0))); " to "; LTrim$(Str$(score(0, 0))); "."
    Else
        Print "The game ended tied at "; LTrim$(Str$(score(0, 0))); "."
    End If
    Print "First-half score: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(score(0, 1))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(score(1, 1))); "."
    Print "Second-half scoring: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(score(0, 2))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(score(1, 2))); "."
    If currHalf > 3 Then
        For overtimeIdx = 3 To currHalf - 1
            Print "Overtime "; LTrim$(Str$(overtimeIdx - 2)); " scoring: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(score(0, overtimeIdx))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(score(1, overtimeIdx))); "."
        Next overtimeIdx
    End If

End Sub


Sub AccessibleTeamBoxscoreMenu (teamIdx)

    Do
        Cls
        Print AccessibleTeamDisplay$(gameTeams$(teamIdx)); " box score."
        Print "1. Hear team totals."
        Print "2. Hear player statistics."
        Print "3. Hear the player list."
        Print "4. Hear the other team."
        Print "5. Return to postgame options."
        commandValue$ = AccessibleReadCommand$("Enter choice: ")
        Select Case commandValue$
            Case "1"
                Call AccessiblePrintTeamTotals(teamIdx)
                commandValue$ = AccessibleReadCommand$("Press Enter to return to team box score options: ")
            Case "2"
                Call AccessiblePlayerBoxscoreMenu(teamIdx)
            Case "3"
                Call AccessiblePrintPlayerList(teamIdx)
                commandValue$ = AccessibleReadCommand$("Press Enter to return to team box score options: ")
            Case "4"
                teamIdx = 1 - teamIdx
            Case "5"
                Exit Do
            Case Else
                Print "Enter a choice from 1 through 5."
                commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
        End Select
    Loop

End Sub


Sub AccessiblePrintTeamTotals (teamIdx)

    Erase statTotals
    For playerIdx = 0 To 13
        If players$(teamIdx, playerIdx) <> "XXX" Then
            statTotals(0) = statTotals(0) + plyrOff_GAME!(teamIdx, playerIdx, 8)
            statTotals(1) = statTotals(1) + plyrOff_GAME!(teamIdx, playerIdx, 7)
            statTotals(2) = statTotals(2) + plyrOff_GAME!(teamIdx, playerIdx, 10)
            statTotals(3) = statTotals(3) + plyrOff_GAME!(teamIdx, playerIdx, 9)
            statTotals(4) = statTotals(4) + plyrOff_GAME!(teamIdx, playerIdx, 11)
            statTotals(5) = statTotals(5) + plyrOff_GAME!(teamIdx, playerIdx, 8) * 2 + plyrOff_GAME!(teamIdx, playerIdx, 10) + threeFG(teamIdx, playerIdx, 0)
            statTotals(6) = statTotals(6) + plyrOff_GAME!(teamIdx, playerIdx, 12)
            statTotals(7) = statTotals(7) + plyrOff_GAME!(teamIdx, playerIdx, 14)
            statTotals(8) = statTotals(8) + plyrOff_GAME!(teamIdx, playerIdx, 15)
            statTotals(9) = statTotals(9) + plyrOff_GAME!(teamIdx, playerIdx, 13)
            statTotals(10) = statTotals(10) + timePlayed(teamIdx, playerIdx)
            statTotals(11) = statTotals(11) + plyrOff_GAME!(teamIdx, playerIdx, 24)
            statTotals(13) = statTotals(13) + threeFG(teamIdx, playerIdx, 0)
            statTotals(14) = statTotals(14) + threeFG(teamIdx, playerIdx, 1)
        End If
    Next playerIdx

    Print AccessibleTeamDisplay$(gameTeams$(teamIdx)); " team totals."
    Print LTrim$(Str$(score(teamIdx, 0))); " points."
    Print "Field goals: "; LTrim$(Str$(statTotals(0))); " made of "; LTrim$(Str$(statTotals(1))); " attempted.";
    If statTotals(1) > 0 Then Print " "; LTrim$(Str$(CInt(statTotals(0) / statTotals(1) * 100))); " percent." Else Print
    Print "Three-pointers: "; LTrim$(Str$(statTotals(13))); " made of "; LTrim$(Str$(statTotals(14))); " attempted.";
    If statTotals(14) > 0 Then Print " "; LTrim$(Str$(CInt(statTotals(13) / statTotals(14) * 100))); " percent." Else Print
    Print "Free throws: "; LTrim$(Str$(statTotals(2))); " made of "; LTrim$(Str$(statTotals(3))); " attempted.";
    If statTotals(3) > 0 Then Print " "; LTrim$(Str$(CInt(statTotals(2) / statTotals(3) * 100))); " percent." Else Print
    Print "Offensive rebounds: "; LTrim$(Str$(statTotals(11))); "."
    Print "Total rebounds: "; LTrim$(Str$(teamRebounds(teamIdx))); "."
    Print "Personal fouls: "; LTrim$(Str$(statTotals(6))); "."
    Print "Assists: "; LTrim$(Str$(statTotals(7))); "."
    Print "Blocks: "; LTrim$(Str$(statTotals(8))); "."
    Print "Steals: "; LTrim$(Str$(statTotals(9))); "."
    Print "Turnovers: "; LTrim$(Str$(turnovers(teamIdx))); "."
    Print "Combined player minutes: "; LTrim$(Str$(Int(statTotals(10) / 60))); "."

End Sub


Sub AccessiblePrintPlayerList (teamIdx)

    Print AccessibleTeamDisplay$(gameTeams$(teamIdx)); " players."
    For playerIdx = 0 To 13
        If players$(teamIdx, playerIdx) <> "XXX" Then
            playerPoints = plyrOff_GAME!(teamIdx, playerIdx, 8) * 2 + plyrOff_GAME!(teamIdx, playerIdx, 10) + threeFG(teamIdx, playerIdx, 0)
            If timePlayed(teamIdx, playerIdx) = 0 Then
                Print LTrim$(Str$(playerIdx + 1)); ". "; players$(teamIdx, playerIdx); ", did not play."
            Else
                Print LTrim$(Str$(playerIdx + 1)); ". "; players$(teamIdx, playerIdx); ", "; LTrim$(Str$(playerPoints)); " points."
            End If
        End If
    Next playerIdx

End Sub


Sub AccessiblePlayerBoxscoreMenu (teamIdx)

    playerIdx = 0
    If IsAccessibleBoxscoreTransitionTestMode% = 1 Then playerIdx = 5
    Do While playerIdx <= 13
        If players$(teamIdx, playerIdx) <> "XXX" Then Exit Do
        playerIdx = playerIdx + 1
    Loop
    If playerIdx > 13 Then Exit Sub

    Do
        Cls
        Call AccessiblePrintPlayerStats(teamIdx, playerIdx)
        Print
        Print "Player options."
        Print "1. Next player."
        Print "2. Previous player."
        Print "3. Repeat this player."
        Print "4. Hear team totals."
        Print "5. Hear the player list."
        Print "6. Hear the other team."
        Print "7. Return to team box score options."
        commandValue$ = AccessibleReadCommand$("Enter choice: ")
        Select Case commandValue$
            Case "1"
                nextPlayer = playerIdx + 1
                Do While nextPlayer <= 13
                    If players$(teamIdx, nextPlayer) <> "XXX" Then Exit Do
                    nextPlayer = nextPlayer + 1
                Loop
                If nextPlayer <= 13 Then
                    playerIdx = nextPlayer
                ElseIf teamIdx = 0 Then
                    Print "You have completed the visiting team player box score for "; AccessibleTeamDisplay$(gameTeams$(teamIdx)); "."
                    Print "Moving to the home team player box score for "; AccessibleTeamDisplay$(gameTeams$(1)); "."
                    commandValue$ = AccessibleReadCommand$("Press Enter to continue to the home team: ")
                    teamIdx = 1
                    playerIdx = 0
                    If IsAccessibleBoxscoreTransitionTestMode% = 1 Then playerIdx = 5
                    Do While playerIdx <= 13
                        If players$(teamIdx, playerIdx) <> "XXX" Then Exit Do
                        playerIdx = playerIdx + 1
                    Loop
                Else
                    Print "You have completed the home team player box score for "; AccessibleTeamDisplay$(gameTeams$(teamIdx)); "."
                    commandValue$ = AccessibleReadCommand$("Press Enter to return to team box score options: ")
                    Exit Do
                End If
            Case "2"
                nextPlayer = playerIdx - 1
                Do While nextPlayer >= 0
                    If players$(teamIdx, nextPlayer) <> "XXX" Then Exit Do
                    nextPlayer = nextPlayer - 1
                Loop
                If nextPlayer >= 0 Then playerIdx = nextPlayer Else Print "This is the first player.": commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
            Case "3"
                'The loop repeats the current player.
            Case "4"
                Call AccessiblePrintTeamTotals(teamIdx)
                commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
            Case "5"
                Call AccessiblePrintPlayerList(teamIdx)
                commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
            Case "6"
                teamIdx = 1 - teamIdx
                playerIdx = 0
                Do While playerIdx <= 13
                    If players$(teamIdx, playerIdx) <> "XXX" Then Exit Do
                    playerIdx = playerIdx + 1
                Loop
            Case "7"
                Exit Do
            Case Else
                Print "Enter a choice from 1 through 7."
                commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
        End Select
    Loop

End Sub


Sub AccessiblePrintPlayerStats (teamIdx, playerIdx)

    Print players$(teamIdx, playerIdx); "."
    If timePlayed(teamIdx, playerIdx) = 0 Then
        Print "Did not play."
        Exit Sub
    End If
    playerPoints = plyrOff_GAME!(teamIdx, playerIdx, 8) * 2 + plyrOff_GAME!(teamIdx, playerIdx, 10) + threeFG(teamIdx, playerIdx, 0)
    playerMinutes = Int(timePlayed(teamIdx, playerIdx) / 60)
    playerSeconds = timePlayed(teamIdx, playerIdx) - playerMinutes * 60
    Print "Minutes played: "; LTrim$(Str$(playerMinutes)); " minutes, "; LTrim$(Str$(playerSeconds)); " seconds."
    Print "Points: "; LTrim$(Str$(playerPoints)); "."
    Print "Field goals: "; LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 8))); " made of "; LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 7))); " attempted."
    Print "Three-pointers: "; LTrim$(Str$(threeFG(teamIdx, playerIdx, 0))); " made of "; LTrim$(Str$(threeFG(teamIdx, playerIdx, 1))); " attempted."
    Print "Free throws: "; LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 10))); " made of "; LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 9))); " attempted."
    Print "Offensive rebounds: "; LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 24))); "."
    Print "Total rebounds: "; LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 11))); "."
    Print "Personal fouls: "; LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 12))); "."
    Print "Assists: "; LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 14))); "."
    Print "Blocks: "; LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 15))); "."
    Print "Steals: "; LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 13))); "."
    Print "Turnovers: "; LTrim$(Str$(plyrOff_GAME!(teamIdx, playerIdx, 23))); "."

End Sub


Sub AccessibleLoadBoxscoreFixture ()

    Erase players$, plyrOff_GAME!, threeFG, timePlayed, score, teamRebounds, turnovers, timeouts
    gameTeams$(0) = "DUKE"
    gameTeams$(1) = "SYRACUSE"
    score(0, 1) = 34: score(0, 2) = 38: score(0, 0) = 72
    score(1, 1) = 37: score(1, 2) = 41: score(1, 0) = 78
    timeouts(0) = 1: timeouts(1) = 2
    teamRebounds(0) = 33: teamRebounds(1) = 37
    turnovers(0) = 13: turnovers(1) = 11

    For teamIdx = 0 To 1
        For playerIdx = 0 To 13
            players$(teamIdx, playerIdx) = "XXX"
        Next playerIdx
    Next teamIdx

    players$(0, 0) = "J. ROACH": players$(0, 1) = "T. PROCTOR": players$(0, 2) = "K. FILIPOWSKI": players$(0, 3) = "M. MITCHELL": players$(0, 4) = "D. Lively": players$(0, 5) = "J. Blakes"
    players$(1, 0) = "G. MCNAMARA": players$(1, 1) = "H. WARRICK": players$(1, 2) = "C. ANTHONY": players$(1, 3) = "C. FORTH": players$(1, 4) = "K. DUANY": players$(1, 5) = "B. EDELIN"

    For teamIdx = 0 To 1
        For playerIdx = 0 To 4
            timePlayed(teamIdx, playerIdx) = 2400
            plyrOff_GAME!(teamIdx, playerIdx, 7) = 8 + playerIdx
            plyrOff_GAME!(teamIdx, playerIdx, 8) = 3 + (playerIdx Mod 3)
            threeFG(teamIdx, playerIdx, 1) = 2 + playerIdx
            threeFG(teamIdx, playerIdx, 0) = playerIdx Mod 3
            plyrOff_GAME!(teamIdx, playerIdx, 9) = 4
            plyrOff_GAME!(teamIdx, playerIdx, 10) = 3
            plyrOff_GAME!(teamIdx, playerIdx, 24) = playerIdx Mod 2
            plyrOff_GAME!(teamIdx, playerIdx, 11) = 3 + playerIdx
            plyrOff_GAME!(teamIdx, playerIdx, 12) = 2
            plyrOff_GAME!(teamIdx, playerIdx, 14) = 1 + playerIdx
            plyrOff_GAME!(teamIdx, playerIdx, 15) = playerIdx Mod 2
            plyrOff_GAME!(teamIdx, playerIdx, 13) = playerIdx Mod 3
            plyrOff_GAME!(teamIdx, playerIdx, 23) = 1 + (playerIdx Mod 2)
        Next playerIdx
        'Exercise a did-not-play player before the final roster entry.
        timePlayed(teamIdx, 5) = timePlayed(teamIdx, 4)
        For fixtureStat = 0 To 24
            plyrOff_GAME!(teamIdx, 5, fixtureStat) = plyrOff_GAME!(teamIdx, 4, fixtureStat)
        Next fixtureStat
        threeFG(teamIdx, 5, 0) = threeFG(teamIdx, 4, 0)
        threeFG(teamIdx, 5, 1) = threeFG(teamIdx, 4, 1)
        timePlayed(teamIdx, 4) = 0
        For fixtureStat = 0 To 24
            plyrOff_GAME!(teamIdx, 4, fixtureStat) = 0
        Next fixtureStat
        threeFG(teamIdx, 4, 0) = 0: threeFG(teamIdx, 4, 1) = 0
    Next teamIdx

    'Keep the fixture internally consistent with the displayed final score.
    plyrOff_GAME!(0, 0, 8) = 8: plyrOff_GAME!(0, 0, 7) = 12
    threeFG(0, 0, 0) = 1: threeFG(0, 0, 1) = 3
    plyrOff_GAME!(0, 0, 10) = 7: plyrOff_GAME!(0, 0, 9) = 8
    plyrOff_GAME!(1, 0, 8) = 10: plyrOff_GAME!(1, 0, 7) = 14
    threeFG(1, 0, 0) = 2: threeFG(1, 0, 1) = 4
    plyrOff_GAME!(1, 0, 10) = 8: plyrOff_GAME!(1, 0, 9) = 10

End Sub


Function AccessibleReadPassChoice% (teamIdx) Static

    Print
    Print "Choose who receives the pass for "; AccessibleTeamDisplay$(gameTeams$(teamIdx)); "."
    For slot = 0 To 4
        Print LTrim$(Str$(slot + 1)); ". "; AccessibleLineupRole$(slot); ": "; players$(teamIdx, lineupIdx(teamIdx, slot)); "."
    Next slot
    Do
        commandValue$ = AccessibleReadCommand$("Enter a player number: ")
        selectedNumber = Val(commandValue$)
        If selectedNumber >= 1 And selectedNumber <= 5 And LTrim$(Str$(selectedNumber)) = commandValue$ Then
            AccessibleReadPassChoice% = selectedNumber - 1
            Exit Function
        End If
        Print "Enter a displayed player number from 1 through 5."
    Loop

End Function


Function AccessibleReadDefenderChoice% (teamIdx) Static

    Print
    Print "Choose the defender for "; AccessibleTeamDisplay$(gameTeams$(teamIdx)); "."
    For slot = 0 To 4
        Print LTrim$(Str$(slot + 1)); ". "; AccessibleLineupRole$(slot); ": "; players$(teamIdx, lineupIdx(teamIdx, slot)); "."
    Next slot
    Do
        commandValue$ = AccessibleReadCommand$("Enter a defender number: ")
        selectedNumber = Val(commandValue$)
        If selectedNumber >= 1 And selectedNumber <= 5 And LTrim$(Str$(selectedNumber)) = commandValue$ Then
            AccessibleReadDefenderChoice% = selectedNumber - 1
            Exit Function
        End If
        Print "Enter a displayed defender number from 1 through 5."
    Loop

End Function


Function AccessibleReadStrategicFoulChoice% (defendingTeam) Static

    AccessibleReadStrategicFoulChoice% = 0
    Call AccessibleFlushPbp
    Do
        Cls
        Print "Late-game defensive decision."
        Call AccessiblePrintGameStatus
        Print AccessibleTeamDisplay$(gameTeams$(P)); " has the ball and is ahead."
        Print "Should "; AccessibleTeamDisplay$(gameTeams$(defendingTeam)); " foul to stop the clock?"
        Print "1. Continue defending without fouling."
        Print "2. Foul and choose the defender."
        commandValue$ = AccessibleReadCommand$("Enter choice: ")
        Select Case commandValue$
            Case "1", "no", "n", "continue", "defend"
                Exit Function
            Case "2", "yes", "y", "foul"
                AccessibleReadStrategicFoulChoice% = 1
                Exit Function
            Case Else
                Print "Enter 1 to continue defending or 2 to foul."
                commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
        End Select
    Loop

End Function


Function AccessibleReadPlayChoice% (teamIdx) Static

    Shared threePtShotChance
    accessibleEngineHumanPrompted = 1
    Do
        'Keep pending simulator narration and the resulting human decision on one
        'screen so a screen reader encounters the pass result before the next menu.
        savedPauseEvents = accessiblePauseEvents
        Cls
        accessiblePauseEvents = 0
        Call AccessibleFlushPbp
        accessiblePauseEvents = savedPauseEvents
        Print
        Print "Your team, "; AccessibleTeamDisplay$(gameTeams$(teamIdx)); ", is on offense."
        Print players$(teamIdx, lineupIdx(teamIdx, ballCarrier)); " has the ball."
        If sClockVal > 0 Then Print "Shot clock: "; LTrim$(Str$(shotClock)); " seconds remaining."
        If shotType = 4 Then
            Print "Current three-point shot chance: "; LTrim$(Str$(threePtShotChance)); " percent."
        Else
            Print "Current two-point shot chance: "; LTrim$(Str$(CInt(shotChance!))); " percent."
        End If
        Select Case shotType
            Case 1
                Print "Current situation: tightly guarded."
            Case 2
                Print "Current situation: open inside."
            Case 3
                Print "Current situation: good opportunity close to the basket."
            Case 4
                Print "Current situation: open from three-point range."
            Case Else
                Print "Current situation: normal defensive coverage."
        End Select
        Print "Offensive choices"
        Print "1. Pass."
        Print "2. Attempt a two-point shot."
        If threePtOpt = 1 Then Print "3. Attempt a three-point shot."
        Print "4. Call timeout."
        Print "5. Hear score, clock, and possession."
        Print "6. Hear lineup condition."
        commandValue$ = AccessibleReadCommand$("Enter choice: ")

        Select Case commandValue$
            Case "1", "pass"
                AccessibleReadPlayChoice% = 0
                Exit Function
            Case "2", "shoot 2", "shoot2", "two"
                AccessibleReadPlayChoice% = 1
                Exit Function
            Case "3", "shoot 3", "shoot3", "three"
                If threePtOpt = 1 Then
                    AccessibleReadPlayChoice% = 4
                    Exit Function
                Else
                    Print "The three-point shot is disabled for this game."
                End If
            Case "4", "timeout", "time out"
                If timeouts(teamIdx) > 0 Then
                    accessibleTimeoutMenuPending = 1
                    AccessibleReadPlayChoice% = 2
                    Exit Function
                Else
                    Print "Your team has no timeouts remaining."
                End If
            Case "5", "status", "score", "clock"
                Call AccessiblePrintGameStatus
            Case "6", "lineup", "condition", "fatigue", "stamina"
                Call AccessiblePrintLineupCondition(teamIdx)
                commandValue$ = AccessibleReadCommand$("Press Enter to return to offensive choices: ")
            Case Else
                If threePtOpt = 1 Then Print "Enter a choice from 1 through 6." Else Print "Enter 1, 2, 4, 5, or 6."
        End Select
    Loop

End Function


Sub AccessiblePrintLineupCondition (teamIdx)

    Print
    Print "Lineup condition for "; AccessibleTeamDisplay$(gameTeams$(teamIdx)); "."
    For slot = 0 To 4
        playerIdx = lineupIdx(teamIdx, slot)
        Print AccessibleLineupRole$(slot); ": "; players$(teamIdx, playerIdx); ", stamina "; LTrim$(Str$(playerStamina%(teamIdx, playerIdx))); ", fatigue "; LTrim$(Str$(Abs(tmFatigue(teamIdx, playerIdx)))); " of 5."
    Next slot

End Sub


Sub AccessiblePrintGameStatus ()

    clockMinutes = Int(gameClock! / 60)
    clockSeconds = Int(gameClock! - clockMinutes * 60)
    clockText$ = LTrim$(Str$(clockMinutes)) + ":"
    If clockSeconds < 10 Then clockText$ = clockText$ + "0"
    clockText$ = clockText$ + LTrim$(Str$(clockSeconds))
    Print "Score: "; AccessibleTeamDisplay$(gameTeams$(0)); " "; LTrim$(Str$(score(0, 0))); ", "; AccessibleTeamDisplay$(gameTeams$(1)); " "; LTrim$(Str$(score(1, 0))); "."
    If currHalf <= 2 Then Print "Half "; LTrim$(Str$(currHalf)); ", "; clockText$; " remaining." Else Print "Overtime "; LTrim$(Str$(currHalf - 2)); ", "; clockText$; " remaining."
    Print "Possession: "; AccessibleTeamDisplay$(gameTeams$(P)); "."
    If sClockVal > 0 Then Print "Shot clock: "; LTrim$(Str$(shotClock)); "."
    Print "Offensive strategy: "; AccessibleTeamDisplay$(gameTeams$(P)); " is running "; _Trim$(offStylesNew$(offStrat(P))); "."
    Print "Defensive strategy: "; AccessibleTeamDisplay$(gameTeams$(D)); " is running "; _Trim$(defStyles$(defStrat(D))); "."

End Sub


Sub AccessibleQueuePbp (teamIdx, eventText$)
    If accessibleEngineStopRequested = 1 Then Exit Sub

    If eventText$ = "" Then Exit Sub
    If accessiblePbpGroupCount > 0 And teamIdx <> accessiblePbpGroupTeam Then Call AccessibleFlushPbp
    If accessiblePbpGroupCount = 0 Then accessiblePbpGroupTeam = teamIdx
    accessiblePbpGroupCount = accessiblePbpGroupCount + 1
    accessiblePbpGroup$(accessiblePbpGroupCount) = eventText$
    accessibleLastPbp$ = eventText$
    If accessiblePbpGroupCount >= 3 Then Call AccessibleFlushPbp

End Sub


Sub AccessibleFlushPbp ()

    If accessiblePbpGroupCount = 0 Then Exit Sub
    If accessiblePauseEvents = 1 Then Cls
    Print "Play-by-play: "; AccessibleTeamDisplay$(gameTeams$(accessiblePbpGroupTeam)); "."
    For eventIdx = 1 To accessiblePbpGroupCount
        Print accessiblePbpGroup$(eventIdx)
    Next eventIdx
    If accessiblePauseEvents = 1 Then
        Line Input "Press Enter to continue, or type end to finish this segment: "; accessibleContinue$
        accessibleContinue$ = LCase$(_Trim$(accessibleContinue$))
        If accessibleContinue$ = "end" Or accessibleContinue$ = "quit" Or accessibleContinue$ = "q" Then accessibleEngineStopRequested = 1
    End If
    accessiblePbpGroupCount = 0
    accessiblePbpGroupTeam = -1
    Erase accessiblePbpGroup$

End Sub


Sub AccessibleDeadBallMenu (humanTeam, userTakeTO)

    Call AccessibleFlushPbp
    userTakeTO = 0
    timeoutCharged = accessibleTimeoutMenuPending
    Do
        Cls
        If timeoutCharged = 1 Then
            Print "Timeout options for "; AccessibleTeamDisplay$(gameTeams$(humanTeam)); "."
            Print "You may make substitutions before continuing play."
        Else
            Print "Dead-ball options for "; AccessibleTeamDisplay$(gameTeams$(humanTeam)); "."
        End If
        Call AccessiblePrintGameStatus
        Print "1. Continue play."
        Print "2. Make a substitution."
        Print "3. Hear the current lineup."
        Print "4. Change offensive style."
        Print "5. Change defensive style."
        Print "6. Call timeout."
        Print "7. End this game segment."
        commandValue$ = AccessibleReadCommand$("Enter choice: ")
        Select Case commandValue$
            Case "1", "continue", "play", "enter"
                Exit Do
            Case "2", "sub", "substitute", "substitution"
                Call AccessibleSubstitutionMenu(humanTeam)
            Case "3", "lineup", "roster"
                If humanTeam = 0 Then roleName$ = "Visiting" Else roleName$ = "Home"
                Call AccessiblePrintLineup(humanTeam, roleName$)
                commandValue$ = AccessibleReadCommand$("Press Enter to return to dead-ball options: ")
            Case "4", "offense", "offensive style"
                ignoredChoice = AccessibleChooseOffense%(humanTeam)
                commandValue$ = AccessibleReadCommand$("Press Enter to return to dead-ball options: ")
            Case "5", "defense", "defensive style", "strategy"
                ignoredChoice = AccessibleChooseDefense%(humanTeam)
                commandValue$ = AccessibleReadCommand$("Press Enter to return to dead-ball options: ")
            Case "6", "timeout", "time out"
                If timeouts(humanTeam) > 0 Then
                    Call TimeoutCalled(humanTeam)
                    timeoutCharged = 1
                    Print "Timeout charged to "; AccessibleTeamDisplay$(gameTeams$(humanTeam)); "."
                    Print "You may now make a substitution or choose another timeout option."
                    commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
                Else
                    Print "Your team has no timeouts remaining."
                    commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
                End If
            Case "7", "end", "quit", "exit", "q"
                accessibleEngineStopRequested = 1
                Exit Do
            Case Else
                Print "Enter a choice from 1 through 7."
                commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
        End Select
    Loop
    accessibleTimeoutMenuPending = 0

End Sub


Sub AccessibleSubstitutionMenu (humanTeam)

    Cls
    Print "Current lineup for "; AccessibleTeamDisplay$(gameTeams$(humanTeam)); "."
    For slot = 0 To 4
        playerIdx = lineupIdx(humanTeam, slot)
        Print LTrim$(Str$(slot + 1)); ". "; AccessibleLineupRole$(slot); ": "; players$(humanTeam, playerIdx); ", fouls "; LTrim$(Str$(plyrOff_GAME!(humanTeam, playerIdx, 12))); ", stamina "; LTrim$(Str$(playerStamina%(humanTeam, playerIdx))); "."
    Next slot

    commandValue$ = AccessibleReadCommand$("Choose the lineup position to replace, 1 through 5, or back: ")
    If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Sub
    selectedSlot = Val(commandValue$) - 1
    If selectedSlot < 0 Or selectedSlot > 4 Or LTrim$(Str$(selectedSlot + 1)) <> commandValue$ Then
        Print "That is not a valid lineup position."
        commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
        Exit Sub
    End If

    Print
    Print "Available substitutes"
    For playerIdx = 0 To 13
        If playerActive%(humanTeam, playerIdx) = 1 And playerInLineup%(humanTeam, playerIdx) = 0 And plyrOff_GAME!(humanTeam, playerIdx, 12) < foulsToDQ And players$(humanTeam, playerIdx) <> "" And UCase$(players$(humanTeam, playerIdx)) <> "XXX" Then
            Print LTrim$(Str$(playerIdx + 1)); ". "; players$(humanTeam, playerIdx); ", "; AccessiblePlayerPosition$(humanTeam, playerIdx); ", fouls "; LTrim$(Str$(plyrOff_GAME!(humanTeam, playerIdx, 12))); ", stamina "; LTrim$(Str$(playerStamina%(humanTeam, playerIdx))); "."
        End If
    Next playerIdx

    commandValue$ = AccessibleReadCommand$("Choose a displayed substitute number, or back: ")
    If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Sub
    selectedPlayer = Val(commandValue$) - 1
    validSelection = 1
    If selectedPlayer < 0 Or selectedPlayer > 13 Then validSelection = 0
    If validSelection = 1 Then
        If LTrim$(Str$(selectedPlayer + 1)) <> commandValue$ Then validSelection = 0
    End If
    If validSelection = 1 Then
        If playerActive%(humanTeam, selectedPlayer) = 0 Then validSelection = 0
        If playerInLineup%(humanTeam, selectedPlayer) = 1 Then validSelection = 0
        If plyrOff_GAME!(humanTeam, selectedPlayer, 12) >= foulsToDQ Then validSelection = 0
        If players$(humanTeam, selectedPlayer) = "" Or UCase$(players$(humanTeam, selectedPlayer)) = "XXX" Then validSelection = 0
    End If
    If validSelection = 0 Then
        Print "That player is not an available substitute."
        commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")
        Exit Sub
    End If

    outgoingPlayer = lineupIdx(humanTeam, selectedSlot)
    lineupIdx(humanTeam, selectedSlot) = selectedPlayer
    Print players$(humanTeam, selectedPlayer); " replaces "; players$(humanTeam, outgoingPlayer); " as "; LCase$(AccessibleLineupRole$(selectedSlot)); "."
    If AccessiblePlayerMatchesRole%(humanTeam, selectedPlayer, selectedSlot) = 0 Then Print "Warning: the substitute's recorded position does not match this lineup role."
    commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")

End Sub


Sub AccessibleReplaceFouledOutPlayer (humanTeam, fouledSlot)

    outgoingPlayer = lineupIdx(humanTeam, fouledSlot)
    Do
        Cls
        Print players$(humanTeam, outgoingPlayer); " has fouled out."
        Print "Choose a replacement for "; LCase$(AccessibleLineupRole$(fouledSlot)); "."
        Print "Available substitutes"
        For playerIdx = 0 To 13
            If playerActive%(humanTeam, playerIdx) = 1 And playerInLineup%(humanTeam, playerIdx) = 0 And plyrOff_GAME!(humanTeam, playerIdx, 12) < foulsToDQ And players$(humanTeam, playerIdx) <> "" And UCase$(players$(humanTeam, playerIdx)) <> "XXX" Then
                Print LTrim$(Str$(playerIdx + 1)); ". "; players$(humanTeam, playerIdx); ", "; AccessiblePlayerPosition$(humanTeam, playerIdx); ", fouls "; LTrim$(Str$(plyrOff_GAME!(humanTeam, playerIdx, 12))); "."
            End If
        Next playerIdx

        commandValue$ = AccessibleReadCommand$("Choose a displayed substitute number: ")
        selectedPlayer = Val(commandValue$) - 1
        validSelection = 1
        If selectedPlayer < 0 Or selectedPlayer > 13 Then validSelection = 0
        If validSelection = 1 Then
            If LTrim$(Str$(selectedPlayer + 1)) <> commandValue$ Then validSelection = 0
        End If
        If validSelection = 1 Then
            If playerActive%(humanTeam, selectedPlayer) = 0 Then validSelection = 0
            If playerInLineup%(humanTeam, selectedPlayer) = 1 Then validSelection = 0
            If plyrOff_GAME!(humanTeam, selectedPlayer, 12) >= foulsToDQ Then validSelection = 0
            If players$(humanTeam, selectedPlayer) = "" Or UCase$(players$(humanTeam, selectedPlayer)) = "XXX" Then validSelection = 0
        End If
        If validSelection = 0 Then Print "That player is not an available substitute."
    Loop Until validSelection = 1

    lineupIdx(humanTeam, fouledSlot) = selectedPlayer
    Print players$(humanTeam, selectedPlayer); " replaces "; players$(humanTeam, outgoingPlayer); " as "; LCase$(AccessibleLineupRole$(fouledSlot)); "."
    commandValue$ = AccessibleReadCommand$("Press Enter to continue: ")

End Sub


Function AccessibleConfigureGame% Static

    AccessibleConfigureGame% = 0

    Print
    Print "Game control"
    Print "1. Human controls both teams."
    Print "2. Human controls home; computer controls visitor."
    Print "3. Human controls visitor; computer controls home."
    Print "4. Computer controls both teams."

    Do
        commandValue$ = AccessibleReadCommand$("Enter control mode, or back: ")
        If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Function
        accessiblePlayerOpt = Val(commandValue$) - 1
        If accessiblePlayerOpt >= 0 And accessiblePlayerOpt <= 3 And LTrim$(Str$(accessiblePlayerOpt + 1)) = commandValue$ Then Exit Do
        Print "Enter a number from 1 through 4."
    Loop

    Print
    Print "Game location"
    Print "1. Home-court advantage."
    Print "2. Neutral site."
    Do
        commandValue$ = AccessibleReadCommand$("Enter location, or back: ")
        If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Function
        accessibleGameLoc = Val(commandValue$)
        If accessibleGameLoc >= 1 And accessibleGameLoc <= 2 And LTrim$(Str$(accessibleGameLoc)) = commandValue$ Then Exit Do
        Print "Enter 1 for home court or 2 for neutral site."
    Loop

    Print
    Print "Rule settings"
    Print "1. Modern college rules: 30-second shot clock, three-point shot, five fouls to disqualify."
    Print "2. Custom rules."
    Do
        commandValue$ = AccessibleReadCommand$("Enter rule set, or back: ")
        If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Function
        If commandValue$ = "1" Or commandValue$ = "modern" Then
            accessibleShotClock = 30
            accessibleThreePoint = 1
            accessibleFoulsToDQ = 5
            Exit Do
        ElseIf commandValue$ = "2" Or commandValue$ = "custom" Then
            Do
                shotValue$ = AccessibleReadCommand$("Shot clock in seconds: 0, 30, 35, or 45: ")
                accessibleShotClock = Val(shotValue$)
                If shotValue$ = "0" Or shotValue$ = "30" Or shotValue$ = "35" Or shotValue$ = "45" Then Exit Do
                Print "Enter 0, 30, 35, or 45."
            Loop
            Do
                threeValue$ = AccessibleReadCommand$("Use the three-point shot? yes or no: ")
                If threeValue$ = "yes" Or threeValue$ = "y" Then
                    accessibleThreePoint = 1
                    Exit Do
                ElseIf threeValue$ = "no" Or threeValue$ = "n" Then
                    accessibleThreePoint = 0
                    Exit Do
                End If
                Print "Enter yes or no."
            Loop
            Do
                foulValue$ = AccessibleReadCommand$("Fouls to disqualify: 5 or 6: ")
                accessibleFoulsToDQ = Val(foulValue$)
                If foulValue$ = "5" Or foulValue$ = "6" Then Exit Do
                Print "Enter 5 or 6."
            Loop
            Exit Do
        Else
            Print "Enter 1 for modern rules or 2 for custom rules."
        End If
    Loop

    Print
    Print "Game configuration summary"
    Select Case accessiblePlayerOpt
        Case 0: Print "Control: human controls both teams."
        Case 1: Print "Control: human controls home; computer controls visitor."
        Case 2: Print "Control: human controls visitor; computer controls home."
        Case 3: Print "Control: computer controls both teams."
    End Select
    If accessibleGameLoc = 1 Then Print "Location: home-court advantage." Else Print "Location: neutral site."
    If accessibleShotClock = 0 Then Print "Shot clock: none." Else Print "Shot clock: "; LTrim$(Str$(accessibleShotClock)); " seconds."
    If accessibleThreePoint = 1 Then Print "Three-point shot: yes." Else Print "Three-point shot: no."
    Print "Fouls to disqualify: "; LTrim$(Str$(accessibleFoulsToDQ)); "."

    commandValue$ = AccessibleReadCommand$("Enter confirm to load the teams, or back: ")
    If commandValue$ = "confirm" Or commandValue$ = "yes" Or commandValue$ = "y" Or commandValue$ = "1" Then AccessibleConfigureGame% = 1

End Function


Function AccessiblePrepareMatchup% (visitorYear$, homeYear$, visitorIdx, homeIdx) Static

    AccessiblePrepareMatchup% = 0
    Call InitVar

    For gameIdx = 0 To 1
        If gameIdx = 0 Then
            selectedIdx = visitorIdx
            targetYear$ = visitorYear$
        Else
            selectedIdx = homeIdx
            targetYear$ = homeYear$
        End If

        diskIDs$(gameIdx) = targetYear$
        teamGender$(gameIdx) = GetTeamGender$(targetYear$)
        teamYears(gameIdx) = Val(targetYear$)

        Call ReadGameTeam(targetYear$, gameTeams$(gameIdx), selectedIdx, gameIdx)
        validData = 0
        Call ReadGameExtraData(targetYear$, selectedIdx, gameIdx, validData)
        If validData = 0 Then
            Print "The data for "; AccessibleTeamDisplay$(gameTeams$(gameIdx)); " could not be loaded."
            Exit Function
        End If

        FY%(gameIdx) = 2 * teamRat_GAME(gameIdx, 3) - teamRat_GAME(gameIdx, 4)
        Call StartingLineup(gameIdx)
        Call TEAMSETUP(gameIdx)
    Next gameIdx

    Print
    Print "Teams loaded successfully."
    Call AccessibleShowLoadedTeam(0, "Visiting")
    Call AccessibleShowLoadedTeam(1, "Home")
    AccessiblePrepareMatchup% = 1

End Function


Sub AccessibleShowLoadedTeam (gameIdx, roleName$)

    Print
    Print roleName$; " team: "; AccessibleTeamDisplay$(gameTeams$(gameIdx))
    If gameCoaches$(gameIdx) <> "" Then Print "Coach: "; gameCoaches$(gameIdx)
    If gameArena$(gameIdx) <> "" Then Print "Arena: "; gameArena$(gameIdx)
    Print "Roster:"
    rosterNumber = 0
    For playerIdx = 0 To 13
        If players$(gameIdx, playerIdx) <> "" And UCase$(players$(gameIdx, playerIdx)) <> "XXX" Then
            rosterNumber = rosterNumber + 1
            Print LTrim$(Str$(rosterNumber)); ". "; players$(gameIdx, playerIdx); ", "; AccessiblePlayerPosition$(gameIdx, playerIdx);
            If playerActive%(gameIdx, playerIdx) = 0 Then Print ", unavailable";
            Print "."
        End If
    Next playerIdx
    commandValue$ = AccessibleReadCommand$("Enter continue when you are ready for the next section: ")

End Sub


Function AccessibleChooseStartingLineups% Static

    AccessibleChooseStartingLineups% = 0

    For gameIdx = 0 To 1
        computerControlled = 0
        If accessiblePlayerOpt = 3 Then computerControlled = 1
        If accessiblePlayerOpt = 1 And gameIdx = 0 Then computerControlled = 1
        If accessiblePlayerOpt = 2 And gameIdx = 1 Then computerControlled = 1

        If gameIdx = 0 Then roleName$ = "Visiting" Else roleName$ = "Home"
        If AccessibleChooseLineup%(gameIdx, roleName$, computerControlled) = 0 Then Exit Function
    Next gameIdx

    Print
    Print "Confirmed starting lineups"
    Call AccessiblePrintLineup(0, "Visiting")
    Call AccessiblePrintLineup(1, "Home")

    For gameIdx = 0 To 1
        computerControlled = 0
        If accessiblePlayerOpt = 3 Then computerControlled = 1
        If accessiblePlayerOpt = 1 And gameIdx = 0 Then computerControlled = 1
        If accessiblePlayerOpt = 2 And gameIdx = 1 Then computerControlled = 1
        If computerControlled = 0 Then
            If AccessibleChooseOffense%(gameIdx) = 0 Then Exit Function
            If AccessibleChooseDefense%(gameIdx) = 0 Then Exit Function
        End If
    Next gameIdx
    AccessibleChooseStartingLineups% = 1

End Function


Function AccessibleChooseLineup% (gameIdx, roleName$, computerControlled) Static

    Dim eligibleIndices(13)

    AccessibleChooseLineup% = 0
    Print
    Print roleName$; " starting lineup for "; AccessibleTeamDisplay$(gameTeams$(gameIdx)); "."

    If computerControlled = 1 Then
        Call AccessibleAutoLineup(gameIdx)
        Print "The computer selected this lineup."
        Call AccessiblePrintLineup(gameIdx, roleName$)
        AccessibleChooseLineup% = 1
        Exit Function
    End If

    Print "You may enter auto for a position-aware recommended lineup, or select five different player numbers."
    eligibleCount = 0
    For playerIdx = 0 To 13
        If playerActive%(gameIdx, playerIdx) = 1 And players$(gameIdx, playerIdx) <> "" And UCase$(players$(gameIdx, playerIdx)) <> "XXX" Then
            eligibleCount = eligibleCount + 1
            eligibleIndices(eligibleCount) = playerIdx
            Print LTrim$(Str$(eligibleCount)); ". "; players$(gameIdx, playerIdx); ", "; AccessiblePlayerPosition$(gameIdx, playerIdx); "."
        End If
    Next playerIdx

    For slot = 0 To 4
        Do
            Print "Role: "; AccessibleLineupRole$(slot); "."
            commandValue$ = AccessibleReadCommand$("Choose the " + LCase$(AccessibleLineupRole$(slot)) + " by player number, or enter auto, repeat, or back: ")
            If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Function
            If commandValue$ = "auto" Then
                Call AccessibleAutoLineup(gameIdx)
                AccessibleChooseLineup% = 1
                Call AccessiblePrintLineup(gameIdx, roleName$)
                Exit Function
            ElseIf commandValue$ = "repeat" Or commandValue$ = "list" Then
                For repeatIdx = 1 To eligibleCount
                    Print LTrim$(Str$(repeatIdx)); ". "; players$(gameIdx, eligibleIndices(repeatIdx)); ", "; AccessiblePlayerPosition$(gameIdx, eligibleIndices(repeatIdx)); "."
                Next repeatIdx
            Else
                selectedNumber = Val(commandValue$)
                If selectedNumber >= 1 And selectedNumber <= eligibleCount And LTrim$(Str$(selectedNumber)) = commandValue$ Then
                    selectedPlayer = eligibleIndices(selectedNumber)
                    duplicatePlayer = 0
                    For checkSlot = 0 To slot - 1
                        If lineupIdx(gameIdx, checkSlot) = selectedPlayer Then duplicatePlayer = 1
                    Next checkSlot
                    If duplicatePlayer = 0 Then
                        lineupIdx(gameIdx, slot) = selectedPlayer
                        Print "Selected "; players$(gameIdx, selectedPlayer); "."
                        If AccessiblePlayerMatchesRole%(gameIdx, selectedPlayer, slot) = 0 Then
                            If RTrim$(positions_GAME$(gameIdx, selectedPlayer)) = "" Then
                                Print "Warning: this season's data does not provide a position for "; players$(gameIdx, selectedPlayer); "."
                            Else
                                Print "Warning: recorded position "; RTrim$(positions_GAME$(gameIdx, selectedPlayer)); " does not match the "; LCase$(AccessibleLineupRole$(slot)); " role."
                            End If
                        End If
                        Exit Do
                    Else
                        Print "That player is already in the lineup."
                    End If
                Else
                    Print "Enter a displayed player number, auto, repeat, or back."
                End If
            End If
        Loop
    Next slot

    Call AccessiblePrintLineup(gameIdx, roleName$)
    commandValue$ = AccessibleReadCommand$("Enter confirm to accept this lineup, or back: ")
    If commandValue$ = "confirm" Or commandValue$ = "yes" Or commandValue$ = "y" Or commandValue$ = "1" Then AccessibleChooseLineup% = 1

End Function


Function AccessibleChooseOffense% (gameIdx) Static

    AccessibleChooseOffense% = 0
    Do
        Print
        Print "Offensive style for "; AccessibleTeamDisplay$(gameTeams$(gameIdx)); "."
        Print "Current style: "; offStylesNew$(offStrat(gameIdx)); "."
        For offenseIdx = 0 To 15
            Print LTrim$(Str$(offenseIdx + 1)); ". "; offStylesNew$(offenseIdx); "."
        Next offenseIdx
        commandValue$ = AccessibleReadCommand$("Choose an offensive style from 1 through 16, or back: ")
        If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Function
        selectedNumber = Val(commandValue$)
        If selectedNumber >= 1 And selectedNumber <= 16 And LTrim$(Str$(selectedNumber)) = commandValue$ Then
            selectedOffense = selectedNumber - 1
            invalidReason$ = ""
            If (selectedOffense = 9 Or selectedOffense = 10 Or selectedOffense = 13 Or selectedOffense = 15) And (currHalf < 2 Or gameClock! > 180) Then invalidReason$ = "That offensive style is only available during the last three minutes of the second half or overtime."
            If selectedOffense = 14 And defCoverage(1 - gameIdx) <> 2 Then invalidReason$ = "Hold ball is only available against a passive zone."
            If selectedOffense = 10 And score(gameIdx, 0) - score(1 - gameIdx, 0) > -11 Then invalidReason$ = "Delay offense is only available when trailing by at least 11 points."
            If selectedOffense = 15 And threePtOpt = 0 Then invalidReason$ = "Shoot only three-pointers is unavailable because the three-point shot is disabled."
            If selectedOffense = 11 And sClockVal = 0 Then invalidReason$ = "Milk the clock is unavailable because the shot clock is disabled."
            If selectedOffense = 13 And score(gameIdx, 0) - score(1 - gameIdx, 0) <= 0 Then invalidReason$ = "Total stall is only available while leading."
            If invalidReason$ <> "" Then
                Print invalidReason$
            Else
                offStrat(gameIdx) = selectedOffense
                crashBoards(gameIdx) = 0
                Print "Offensive style set to "; offStylesNew$(selectedOffense); "."
                If currHalf >= 2 And gameClock! <= 120 Then
                    Do
                        commandValue$ = AccessibleReadCommand$("Crash the offensive boards during the last two minutes, yes or no: ")
                        If commandValue$ <> "yes" And commandValue$ <> "y" And commandValue$ <> "1" And commandValue$ <> "no" And commandValue$ <> "n" And commandValue$ <> "0" Then Print "Enter yes or no."
                    Loop Until commandValue$ = "yes" Or commandValue$ = "y" Or commandValue$ = "1" Or commandValue$ = "no" Or commandValue$ = "n" Or commandValue$ = "0"
                    If commandValue$ = "yes" Or commandValue$ = "y" Or commandValue$ = "1" Then crashBoards(gameIdx) = 1
                    If crashBoards(gameIdx) = 1 Then Print "The team will crash the offensive boards." Else Print "The team will not crash the offensive boards."
                End If
                AccessibleChooseOffense% = 1
                Exit Function
            End If
        Else
            Print "Enter a displayed offensive-style number from 1 through 16, or back."
        End If
    Loop

End Function


Function AccessibleChooseDefense% (gameIdx) Static

    AccessibleChooseDefense% = 0
    Do
        Print
        Print "Defensive style for "; AccessibleTeamDisplay$(gameTeams$(gameIdx)); "."
        Print "Current style: "; defStyles$(defStrat(gameIdx)); "."
        For defenseIdx = 0 To 17
            Print LTrim$(Str$(defenseIdx + 1)); ". "; defStyles$(defenseIdx); "."
        Next defenseIdx
        commandValue$ = AccessibleReadCommand$("Choose a defensive style from 1 through 18, or back: ")
        If commandValue$ = "back" Or commandValue$ = "cancel" Then Exit Function
        selectedNumber = Val(commandValue$)
        If selectedNumber >= 1 And selectedNumber <= 18 And LTrim$(Str$(selectedNumber)) = commandValue$ Then
            selectedDefense = selectedNumber - 1
            If selectedDefense = 14 And (currHalf < 2 Or gameClock! > 180) Then
                Print "Full-court denial is only available during the last three minutes of the second half or overtime."
            Else
                defStrat(gameIdx) = selectedDefense
                Call CategorizeDefense(gameIdx)
                Print "Defensive style set to "; defStyles$(selectedDefense); "."
                AccessibleChooseDefense% = 1
                Exit Function
            End If
        Else
            Print "Enter a displayed defensive-style number from 1 through 18, or back."
        End If
    Loop

End Function


Sub AccessibleAutoLineup (gameIdx)

    For slot = 0 To 4
        bestPlayer = -1
        bestContribution! = -1

        'First pass: honor the recorded position whenever possible.
        For playerIdx = 0 To 13
            alreadyChosen = 0
            For checkSlot = 0 To slot - 1
                If lineupIdx(gameIdx, checkSlot) = playerIdx Then alreadyChosen = 1
            Next checkSlot
            If alreadyChosen = 0 And playerActive%(gameIdx, playerIdx) = 1 And players$(gameIdx, playerIdx) <> "" And UCase$(players$(gameIdx, playerIdx)) <> "XXX" And AccessiblePlayerMatchesRole%(gameIdx, playerIdx, slot) = 1 Then
                If plyrOff_GAME!(gameIdx, playerIdx, 3) > bestContribution! Then
                    bestContribution! = plyrOff_GAME!(gameIdx, playerIdx, 3)
                    bestPlayer = playerIdx
                End If
            End If
        Next playerIdx

        'Fallback: use the best remaining eligible player and announce why.
        If bestPlayer = -1 Then
            bestContribution! = -1
            For playerIdx = 0 To 13
                alreadyChosen = 0
                For checkSlot = 0 To slot - 1
                    If lineupIdx(gameIdx, checkSlot) = playerIdx Then alreadyChosen = 1
                Next checkSlot
                If alreadyChosen = 0 And playerActive%(gameIdx, playerIdx) = 1 And players$(gameIdx, playerIdx) <> "" And UCase$(players$(gameIdx, playerIdx)) <> "XXX" Then
                    If plyrOff_GAME!(gameIdx, playerIdx, 3) > bestContribution! Then
                        bestContribution! = plyrOff_GAME!(gameIdx, playerIdx, 3)
                        bestPlayer = playerIdx
                    End If
                End If
            Next playerIdx
            If bestPlayer >= 0 Then
                Print "Warning: no available player with a recorded "; LCase$(AccessibleLineupRole$(slot)); " position."
                Print players$(gameIdx, bestPlayer); " was assigned to "; LCase$(AccessibleLineupRole$(slot)); " based on contribution rating."
            End If
        End If
        lineupIdx(gameIdx, slot) = bestPlayer
    Next slot

End Sub


Sub AccessiblePrintLineup (gameIdx, roleName$)

    Print roleName$; " lineup:"
    For slot = 0 To 4
        playerIdx = lineupIdx(gameIdx, slot)
        If playerIdx >= 0 Then
            Print LTrim$(Str$(slot + 1)); ". "; AccessibleLineupRole$(slot); ": "; players$(gameIdx, playerIdx); ", "; AccessiblePlayerPosition$(gameIdx, playerIdx); "."
        End If
    Next slot

End Sub


Function AccessiblePlayerPosition$ (gameIdx, playerIdx) Static

    positionText$ = RTrim$(positions_GAME$(gameIdx, playerIdx))
    If positionText$ = "" Then
        AccessiblePlayerPosition$ = "position not provided in this season's data"
    Else
        AccessiblePlayerPosition$ = "position " + positionText$
    End If

End Function


Function AccessibleLineupRole$ (slot) Static

    Select Case slot
        Case 0: AccessibleLineupRole$ = "First guard"
        Case 1: AccessibleLineupRole$ = "Second guard"
        Case 2: AccessibleLineupRole$ = "First forward"
        Case 3: AccessibleLineupRole$ = "Second forward"
        Case 4: AccessibleLineupRole$ = "Center"
        Case Else: AccessibleLineupRole$ = "Unknown role"
    End Select

End Function


Function AccessiblePlayerMatchesRole% (gameIdx, playerIdx, slot) Static

    positionText$ = UCase$(RTrim$(positions_GAME$(gameIdx, playerIdx)))
    AccessiblePlayerMatchesRole% = 0
    If slot <= 1 And InStr(positionText$, "G") > 0 Then AccessiblePlayerMatchesRole% = 1
    If slot >= 2 And slot <= 3 And InStr(positionText$, "F") > 0 Then AccessiblePlayerMatchesRole% = 1
    If slot = 4 And InStr(positionText$, "C") > 0 Then AccessiblePlayerMatchesRole% = 1

End Function


Function AccessibleChooseTeam% (roleName$, yearNumber$, chosenIdx, teamName$) Static

    Dim matchIndices(MAX_TEAMS)

    AccessibleChooseTeam% = 0

    Do
        If chosenIdx = 0 Then
            Print
            Print "Choose the "; roleName$; " team."

            If yearNumber$ = "" Then
                commandValue$ = AccessibleReadCommand$("Enter season ID, such as 2025, or back: ")
            Else
                Print "Current season ID: "; yearNumber$
                commandValue$ = AccessibleReadCommand$("Press Enter to use it, enter another season ID, or back: ")
                If commandValue$ = "" Then commandValue$ = yearNumber$
            End If

            If commandValue$ = "back" Or commandValue$ = "cancel" Or commandValue$ = "exit" Then Exit Function

            If AccessibleLoadTeams%(commandValue$) = 0 Then
                Print "No team data was found for season ID "; commandValue$; "."
                Print "Try a four-digit season from 1959 through 2025."
            Else
                yearNumber$ = commandValue$

                Do
                    searchValue$ = AccessibleReadCommand$("Enter part of a team name, list, or back: ")
                    If searchValue$ = "back" Or searchValue$ = "cancel" Then Exit Do

                    matchCount = 0
                    For teamIdx = 1 To teamIndex(0)
                        If searchValue$ = "list" Or searchValue$ = "" Or InStr(LCase$(teamNames$(teamIdx)), searchValue$) > 0 Then
                            matchCount = matchCount + 1
                            matchIndices(matchCount) = teamIdx
                        End If
                    Next teamIdx

                    If matchCount = 0 Then
                        Print "No teams matched. Try another search."
                    Else
                        displayCount = matchCount
                        If displayCount > 25 Then displayCount = 25
                        Print LTrim$(Str$(matchCount)); " team(s) matched."
                        For matchIdx = 1 To displayCount
                            Print LTrim$(Str$(matchIdx)); ". "; AccessibleTeamDisplay$(teamNames$(matchIndices(matchIdx)))
                        Next matchIdx
                        If matchCount > displayCount Then Print "Only the first 25 matches are shown. Narrow the search to see fewer results."

                        selectionValue$ = AccessibleReadCommand$("Enter a displayed team number, search, or back: ")
                        If selectionValue$ = "back" Or selectionValue$ = "cancel" Then Exit Do
                        If selectionValue$ <> "search" Then
                            selectedNumber = Val(selectionValue$)
                            If selectedNumber >= 1 And selectedNumber <= displayCount And LTrim$(Str$(selectedNumber)) = selectionValue$ Then
                                chosenIdx = teamIndex(matchIndices(selectedNumber))
                                teamName$ = teamNames$(matchIndices(selectedNumber))
                                Print "Selected "; AccessibleTeamDisplay$(teamName$); " as the "; roleName$; " team."
                                AccessibleChooseTeam% = 1
                                Exit Function
                            Else
                                Print "That is not a displayed team number."
                            End If
                        End If
                    End If
                Loop
            End If
        Else
            AccessibleChooseTeam% = 1
            Exit Function
        End If
    Loop

End Function


Function AccessibleTeamDisplay$ (teamName$) Static

    displayName$ = RTrim$(teamName$)
    If Len(displayName$) >= 4 Then
        If Mid$(displayName$, 3, 1) = " " And Val(Left$(displayName$, 2)) > 0 Then displayName$ = Mid$(displayName$, 4)
    End If
    AccessibleTeamDisplay$ = displayName$

End Function


Function AccessibleLoadTeams% (yearNumber$) Static

    AccessibleLoadTeams% = 0
    teamFile$ = diskPaths$(0) + TEAM_FILE_NAME$ + "." + yearNumber$
    dataFile$ = diskPaths$(0) + DATA_FILE_NAME$ + "." + yearNumber$

    If Not _FileExists(teamFile$) Or Not _FileExists(dataFile$) Then Exit Function

    Open teamFile$ For Random As #1 Len = TEAM_SIZE_BYTES
    fileLength& = LOF(1)
    numberTeams = fileLength& / TEAM_SIZE_BYTES
    If numberTeams > MAX_TEAMS Then numberTeams = MAX_TEAMS
    Field #1, 15 As Q$(0)

    For teamIdx = 1 To numberTeams
        Get #1, teamIdx
        teamNames$(teamIdx) = Q$(0)
        teamIndex(teamIdx) = teamIdx
    Next teamIdx
    Close #1

    teamIndex(0) = numberTeams
    AccessibleLoadTeams% = numberTeams

End Function


Sub AccessibleShowHelp ()

    Print "Accessibility help"
    Print "This mode uses complete lines of text so screen readers can follow the game."
    Print "Enter a menu number or its command word, then press Enter."
    Print "No mouse, color, graphics, or cursor position is required."
    Print "At the main menu, enter play, help, or exit."

End Sub
